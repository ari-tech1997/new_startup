# Required: LLM provider key used by the crew's agents.
OPENAI_API_KEY=sk-...

# Optional: override the default model (see crewai.LLM / LiteLLM docs).
MODEL=gpt-4o

# No API key is required for market data: the MCP server
# (src/new_startup/mcp_server) uses yfinance, which reads public Yahoo
# Finance endpoints with no authentication.
